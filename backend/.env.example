# MongoDB Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pathwai

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# JWT Security
JWT_SECRET_KEY=your_64_char_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Twilio SMS (OTP)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Resend (Email)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pathwai-storage
R2_ENDPOINT_URL=https://{account_id}.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev

# Firebase Admin SDK (for Push Notifications)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# JSearch API (RapidAPI - Job Market)
JSEARCH_API_KEY=your_rapidapi_key

# RAG Guidance API Endpoint
RAG_ENDPOINT_URL=https://rag-api.example.com/api/v1
RAG_API_KEY=your_rag_auth_key

# Application Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
PORT=8000
